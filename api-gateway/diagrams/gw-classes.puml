@startuml gw-classes
' UML · Clases: estructura estática del API Gateway (tabla de rutas, políticas de acceso, identidad propagada, cortes de sesión y errores propios).
' Fuente: api-gateway (develop) config/GatewayRoutesProperties, security/*, sessioncuts/SessionCutSnapshot y SessionCutStore, error/GatewayError, ErrorResponse y GatewayException. Sin filtros, configuración de Spring ni utilidades.
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members
title API Gateway · Diagrama de clases

class GatewayRoutesProperties <<@ConfigurationProperties gateway>> {
    - downstreamTimeout : Duration
    - routes : List<Route>
    - pathTimeouts : List<PathTimeout>
    + responseTimeoutOf(path : String) : Duration
}

class Route <<record>> {
    - id : String
    - uri : URI
    - paths : List<String>
}

class PathTimeout <<record>> {
    - path : String
    - timeout : Duration
}

class Endpoint <<record>> {
    - method : HttpMethod
    - path : String
}

class AccessPolicyResolver <<@Component>> {
    - publicRoutes : List<Endpoint>
    - internalRoutes : List<Endpoint>
    + resolve(method : HttpMethod, path : String) : AccessPolicy
}

enum AccessPolicy {
    PUBLICA
    INTERNA
    PROTEGIDA
}

class JwtValidator <<@Component>> {
    - verifier : RSASSAVerifier
    - properties : JwtProperties
    - clock : Clock
    + validate(token : String) : AuthenticatedUser
}

class ServiceKeyAuthenticator <<@Component>> {
    - digestsByService : Map<String, byte[]>
    + authenticate(serviceKey : String) : CallingService
}

class AuthenticatedUser <<record>> {
    - userId : String
    - roles : List<String>
    - permissions : List<String>
}

class CallingService <<record>> {
    - name : String
}

class SessionCutStore <<@Component>> {
    + replace(snapshot : SessionCutSnapshot) : void
    + isCut(userId : String, roles : List<String>, issuedAt : Instant) : boolean
}

class SessionCutSnapshot <<record>> {
    - users : Map<String, Instant>
    - roles : Map<String, Instant>
}

enum GatewayError {
    VALIDATION
    UNAUTHORIZED
    FORBIDDEN
    NOT_FOUND
    INTERNAL_ERROR
    SERVICE_UNAVAILABLE
    TIMEOUT
    --
    - status : HttpStatus
    - codigo : String
    - mensaje : String
}

class GatewayException {
    - error : GatewayError
    + error() : GatewayError
}

class RuntimeException

class ErrorResponse <<record>> {
    - status : int
    - codigo : String
    - mensaje : String
    - errores : List<FieldError>
    - correlationId : String
}

class FieldError <<record>> {
    - campo : String
    - mensaje : String
}

GatewayRoutesProperties "1" *-- "1..*" Route : routes
GatewayRoutesProperties "1" *-- "0..*" PathTimeout : pathTimeouts
AccessPolicyResolver "1" o-- "0..*" Endpoint : públicas e internas
AccessPolicyResolver "0..*" --> "1" AccessPolicy : resuelve >
JwtValidator "1" --> "1" SessionCutStore : consulta (isCut) >
JwtValidator "1" -- "0..*" AuthenticatedUser : produce >
ServiceKeyAuthenticator "1" -- "0..*" CallingService : identifica >
SessionCutStore "1" o-- "1" SessionCutSnapshot : última instantánea
RuntimeException <|-- GatewayException
GatewayException "0..*" --> "1" GatewayError : error
ErrorResponse "1" *-- "0..*" FieldError : errores
GatewayError "1" -- "0..*" ErrorResponse : se escribe como >

note right of AuthenticatedUser
  Sale del JWT o de las cabeceras X-User-* que
  propaga un MS autenticado; el GW la inyecta
  hacia el MS como X-User-Id, X-User-Role
  y X-User-Permission.
end note
note bottom of SessionCutSnapshot
  SessionCutsPoller la pide a MS01 al arrancar
  y cada 4 s; un token emitido antes de un
  corte de su usuario o de uno de sus roles
  se rechaza con 401.
end note
note right of Endpoint
  Método + ruta exacta, sin comodines.
  Lo que no es público ni interno
  es PROTEGIDA.
end note
@enduml
