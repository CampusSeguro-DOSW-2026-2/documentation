@startuml gw-classes
' UML · Clases del API Gateway: estructura estática de su dominio (rutas, políticas de acceso, identidad, cortes de
' sesión y errores propios). Fuente: src/main/java/.../gateway_service (config, security, sessioncuts, error).
' Se omiten filtros, configuraciones Spring y utilidades (están en el diagrama de componentes).
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 70
hide empty members
title API Gateway · Diagrama de clases

package "Enrutamiento" {
    class GatewayRoutesProperties <<record>> {
        - downstreamTimeout : Duration
        + isPathsUnique() : boolean
    }
    class Route <<record>> {
        - id : String
        - uri : URI
        - paths : List<String>
        + isUriValid() : boolean
    }
}

package "Control de acceso" {
    class AccessPolicyResolver {
        + resolve(method : HttpMethod, path : String) : AccessPolicy
    }
    class Endpoint <<record>> {
        - method : HttpMethod
        - path : String
    }
    enum AccessPolicy {
        PUBLICA
        INTERNA
        PROTEGIDA
    }
    class JwtValidator {
        - properties : JwtProperties
        + validate(token : String) : AuthenticatedUser
    }
    class ServiceKeyAuthenticator {
        - digestsByService : Map<String, byte[]>
        + authenticate(serviceKey : String) : CallingService
    }
    class AuthenticatedUser <<record>> {
        - userId : String
        - roles : List<String>
        - permissions : List<String>
    }
    class CallingService <<record>> {
        - name : String
    }
}

package "Cortes de sesión" {
    class SessionCutStore {
        + replace(snapshot : SessionCutSnapshot) : void
        + isCut(userId : String, roles : List<String>, issuedAt : Instant) : boolean
    }
    class SessionCutSnapshot <<record>> {
        - users : Map<String, Instant>
        - roles : Map<String, Instant>
    }
    class SessionCutsPoller {
        + start() : void
        + stop() : void
    }
    class SessionCutsClient {
        + fetch() : Mono<SessionCutSnapshot>
    }
}

package "Errores" {
    class GatewayException {
        - error : GatewayError
    }
    enum GatewayError {
        VALIDATION (400)
        UNAUTHORIZED (401)
        FORBIDDEN (403)
        NOT_FOUND (404)
        INTERNAL_ERROR (500)
        SERVICE_UNAVAILABLE (502)
        TIMEOUT (504)
        - codigo : String
        - mensaje : String
    }
    class ErrorResponse <<record>> {
        - status : int
        - codigo : String
        - mensaje : String
        - correlationId : String
    }
    class FieldError <<record>> {
        - campo : String
        - mensaje : String
    }
    class RuntimeException
}

' Composición: las rutas y los endpoints no existen sin su configuración
GatewayRoutesProperties "1" *-- "1..*" Route : routes >
AccessPolicyResolver "1" *-- "0..*" Endpoint : públicas e internas >
AccessPolicyResolver "1" --> "0..*" AccessPolicy : resuelve >

' Asociaciones del control de acceso
JwtValidator "1" --> "0..*" AuthenticatedUser : produce >
ServiceKeyAuthenticator "1" --> "0..*" CallingService : identifica >
JwtValidator "0..*" --> "1" SessionCutStore : consulta >

' Cortes de sesión: el store agrega la instantánea vigente, que el poller reemplaza
SessionCutStore "1" o-- "1" SessionCutSnapshot : actual >
SessionCutsPoller "1" --> "1" SessionCutsClient : usa >
SessionCutsPoller "1" --> "1" SessionCutStore : reemplaza >
SessionCutsClient "1" --> "0..*" SessionCutSnapshot : obtiene >

' Errores
RuntimeException <|-- GatewayException
GatewayException "0..*" --> "1" GatewayError : error >
ErrorResponse "1" *-- "0..*" FieldError : errores >
ErrorResponse "0..*" --> "1" GatewayError : se construye con >

' Layout: dos filas (enrutamiento y control de acceso arriba; cortes de sesión y errores abajo)
Route -[hidden]down- SessionCutsPoller
CallingService -[hidden]down- SessionCutsPoller
AuthenticatedUser -[hidden]down- GatewayException
AccessPolicy -[hidden]down- RuntimeException
@enduml
