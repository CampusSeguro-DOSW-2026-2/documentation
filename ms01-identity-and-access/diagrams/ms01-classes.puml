@startuml ms01_clases
' UML · Clases: estructura estática del dominio de MS01 (usuarios, roles y permisos en BD, registro, recuperación y auditoría).
' Fuente: ms01-identity-and-access (develop) entity/*, security/RequesterIdentity, audit/AuditEvent, AuditAction, AuditResult. Sin DTOs, controladores ni utilidades.
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
hide empty members
title MS01 Identidad y acceso · Diagrama de clases del dominio

class UserEntity <<@Entity users>> {
    - id : UUID
    - firstName : String
    - secondName : String
    - firstLastName : String
    - secondLastName : String
    - email : String
    - password : String
    - roles : Set<RoleEntity>
    - state : UserState
    - createdAt : Instant
    - updatedAt : Instant
    - validFrom : Instant
    + getRoleNames() : List<String>
    + setRoles(roles : Set<RoleEntity>) : void
}

class RoleEntity <<@Entity roles>> {
    - id : UUID
    - name : String
    - description : String
    - permissions : Set<PermissionEntity>
    - system : boolean
    - validFrom : Instant
    - createdAt : Instant
    - updatedAt : Instant
    + isSystem() : boolean
    + setPermissions(permissions : Set<PermissionEntity>) : void
}

class PermissionEntity <<@Entity permissions>> {
    - id : UUID
    - name : String
    - description : String
}

enum Permission {
    MS01_PROFILE_READ
    MS01_PROFILE_WRITE
    MS01_PASSWORD_CHANGE
    MS01_SESSION_LOGOUT
    MS01_ROLE_READ_OWN
    MS01_ROLE_READ_ALL
    MS01_ROLE_MANAGE
    MS01_USER_READ
    MS01_USER_STATUS
    MS01_USER_ROLES
    --
    - code : String
    - description : String
    + getCode() : String
}

enum UserState {
    ACTIVO
    INACTIVO
}

class PasswordResetCodeEntity <<@Entity password_reset_codes>> {
    - id : UUID
    - userId : UUID
    - codeHash : String
    - attempts : int
    - expiresAt : Instant
    - usedAt : Instant
    - createdAt : Instant
    + isActiveAt(now : Instant) : boolean
}

class PendingRegistrationEntity <<@Entity pending_registrations>> {
    - email : String
    - firstName : String
    - secondName : String
    - firstLastName : String
    - secondLastName : String
    - passwordHash : String
    - codeHash : String
    - requestTokenHash : String
    - attempts : int
    - expiresAt : Instant
    - codeSentAt : Instant
    - codesSent : int
    - windowStartedAt : Instant
    + isCodeActiveAt(now : Instant) : boolean
}

class RequesterIdentity <<record>> {
    - userId : UUID
    - roles : Set<String>
    - permissions : Set<String>
    + hasPermission(p : Permission) : boolean
    + hasPermission(code : String) : boolean
    + rolesHeader() : String
}

class AuditEvent <<record>> {
    - accion : AuditAction
    - resultado : AuditResult
    - usuarioId : UUID
    - usuarioRoles : String
    - detalle : String
    - correlationId : String
    - fecha : Instant
    - recursoAfectado : String
}

enum AuditAction {
    REGISTRO
    LOGIN
    LOGOUT
    CAMBIO_ROL
    CREACION_ROL
    EDICION_ROL
    CAMBIO_PERMISOS_ROL
    ELIMINACION_ROL
    CAMBIO_ESTADO
    CAMBIO_CONTRASENA
    RECUPERACION
}

enum AuditResult {
    EXITO
    FALLO
}

UserEntity "0..*" -- "1..*" RoleEntity : tiene (user_roles) >
RoleEntity "0..*" -- "1..*" PermissionEntity : otorga (role_permissions) >
UserEntity "0..*" --> "1" UserState : state
PasswordResetCodeEntity "0..*" -- "1" UserEntity : pertenece a (userId) >
Permission "0..1" -- "1" PermissionEntity : se sincroniza con (code = name) >
RequesterIdentity "0..*" -- "1" UserEntity : identifica (userId) >
AuditEvent "0..*" -- "0..1" UserEntity : ejecutada por (usuarioId) >
AuditEvent "0..*" --> "1" AuditAction : accion
AuditEvent "0..*" --> "1" AuditResult : resultado

note right of PendingRegistrationEntity
  Registro sin verificar, sin relación con users:
  al verificar el código de 6 dígitos se crea el
  UserEntity con el rol ESTUDIANTE y se borra la fila.
end note
note top of RequesterIdentity
  Identidad del solicitante, construida con
  X-User-Id, X-User-Role y X-User-Permission
  que inyecta el API Gateway.
end note
note bottom of Permission
  Catálogo de MS01 en el código: al arrancar,
  PermissionCatalogSynchronizer inserta o borra las
  filas ms01:* de permissions. Las de ms02 a ms08
  solo existen en la base de datos.
end note
@enduml
