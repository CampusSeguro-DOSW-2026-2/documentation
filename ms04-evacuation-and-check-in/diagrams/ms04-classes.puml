@startuml uml_clases
' UML · Clases del dominio de MS04 Evacuación y check-in. Fuente: paquete entity/ de origin/develop (rama develop).
' Las entidades se enlazan por id (eventoId, checkinId), sin @ManyToOne: la asociación es lógica y la garantiza la FK de la BD.
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype polyline
title MS04 Evacuación y check-in · Diagrama de clases del dominio

class Evento {
  - id : UUID
  - nombre : String
  - simulacro : boolean
  - estado : EstadoEvento
  - fechaInicio : Instant
  - fechaCierre : Instant
  - rolesConvocados : List<String>
  - escenarioEdificios : List<String>
  - escenarioZonas : List<String>
  - creadoEn : Instant
  - actualizadoEn : Instant
  + isCheckinHabilitado() : boolean
  + corteDePoblacion(ahora : Instant) : Instant
}

class Checkin <<solo inserción>> {
  - id : UUID
  - numero : Long
  - eventoId : UUID
  - usuarioId : UUID
  - estado : EstadoCheckin
  - puntoEncuentroId : UUID
  - ubicacionTipo : TipoUbicacion
  - ubicacionId : UUID
  - registradoEn : Instant
}

class SolicitudAsistencia {
  - id : UUID
  - checkinId : UUID
  - eventoId : UUID
  - usuarioId : UUID
  - ubicacionTipo : TipoUbicacion
  - ubicacionId : UUID
  - solicitudMs05Id : String
  - estadoEnvio : EstadoEnvio
  - intentos : int
  - ultimoIntentoEn : Instant
  - rolesSolicitante : String
  - permisosSolicitante : String
  - reportadaEn : Instant
  - actualizadoEn : Instant
  + setIdentidadSolicitante(roles : String, permisos : String) : void
}

enum EstadoEvento {
  BORRADOR
  PROGRAMADO
  EN_EJECUCION
  FINALIZADO
}

enum EstadoCheckin {
  SAFE
  EVACUATING
  NEEDS_ASSISTANCE
  OFF_CAMPUS
}

enum EstadoEnvio {
  ENVIADA
  PENDIENTE_ENVIO
  RECHAZADA
}

enum TipoUbicacion {
  EDIFICIO
  ESPACIO
  PUNTO_ENCUENTRO
}

Evento "1" -- "0..*" Checkin : registra >
Evento "1" -- "0..*" SolicitudAsistencia : recibe >
Checkin "1" -- "0..*" SolicitudAsistencia : origina >

Evento --> "1" EstadoEvento : estado
Checkin --> "1" EstadoCheckin : estado
Checkin --> "0..1" TipoUbicacion : ubicacionTipo
SolicitudAsistencia --> "1" EstadoEnvio : estadoEnvio
SolicitudAsistencia --> "1" TipoUbicacion : ubicacionTipo

note bottom of Checkin
  El estado vigente de una persona es su check-in
  más reciente en el evento (mayor registradoEn, luego numero).
end note
@enduml
