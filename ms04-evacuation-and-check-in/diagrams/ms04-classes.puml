@startuml ms04-classes
' UML · Clases: estructura estática del dominio de MS04 (eventos, check-ins, solicitudes de asistencia, identidad y auditoría).
' Fuente: ms04-evacuation-and-check-in (develop) entity/*, security/RequesterIdentity, security/Permiso, audit/AuditEvent, AuditContext, AuditAction, AuditResult. Sin DTOs, controladores ni utilidades.
skinparam classAttributeIconSize 0
skinparam shadowing false
hide empty members
title MS04 · Diagrama de clases

class Evento <<@Entity eventos>> {
    - id : UUID
    - nombre : String
    - simulacro : boolean
    - estado : EstadoEvento
    - fechaInicio : Instant
    - fechaCierre : Instant
    - rolesConvocados : List<String>
    - escenarioEdificios : List<String>
    - escenarioZonas : List<String>
    - creadoEn : Instant
    - actualizadoEn : Instant
    + isCheckinHabilitado() : boolean
    + corteDePoblacion(ahora : Instant) : Instant
}

class Checkin <<@Entity checkins>> {
    - id : UUID
    - numero : Long
    - eventoId : UUID
    - usuarioId : UUID
    - estado : EstadoCheckin
    - puntoEncuentroId : UUID
    - ubicacionTipo : TipoUbicacion
    - ubicacionId : UUID
    - registradoEn : Instant
    + Checkin(eventoId : UUID, usuarioId : UUID, estado : EstadoCheckin, puntoEncuentroId : UUID, ubicacionTipo : TipoUbicacion, ubicacionId : UUID)
}

class SolicitudAsistencia <<@Entity solicitudes_asistencia>> {
    - id : UUID
    - checkinId : UUID
    - eventoId : UUID
    - usuarioId : UUID
    - ubicacionTipo : TipoUbicacion
    - ubicacionId : UUID
    - solicitudMs05Id : String
    - estadoEnvio : EstadoEnvio
    - intentos : int
    - ultimoIntentoEn : Instant
    - rolesSolicitante : String
    - permisosSolicitante : String
    - reportadaEn : Instant
    - actualizadoEn : Instant
    + setEstadoEnvio(estadoEnvio : EstadoEnvio) : void
    + setIdentidadSolicitante(roles : String, permisos : String) : void
}

enum EstadoEvento {
    BORRADOR
    PROGRAMADO
    EN_EJECUCION
    FINALIZADO
}

enum EstadoCheckin {
    SAFE
    EVACUATING
    NEEDS_ASSISTANCE
    OFF_CAMPUS
}

enum TipoUbicacion {
    EDIFICIO
    ESPACIO
    PUNTO_ENCUENTRO
}

enum EstadoEnvio {
    ENVIADA
    PENDIENTE_ENVIO
    RECHAZADA
}

class RequesterIdentity <<record>> {
    - userId : UUID
    - roles : Set<String>
    - permisos : Set<String>
    + tienePermiso(permiso : Permiso) : boolean
    + rolesComoCabecera() : String
    + permisosComoCabecera() : String
}

enum Permiso {
    CHECKIN_WRITE
    CHECKIN_READ_OWN
    ASSISTANCE_REQUEST
    DASHBOARD_READ
    HISTORY_READ
    --
    - code : String
    + getCode() : String
}

class AuditEvent <<record>> {
    - id : UUID
    - accion : AuditAction
    - resultado : AuditResult
    - usuarioId : UUID
    - usuarioRoles : String
    - usuarioPermisos : String
    - detalle : String
    - correlationId : String
    - fecha : Instant
    - recursoAfectado : String
    - contexto : AuditContext
}

class AuditContext <<record>> {
    - eventoId : UUID
    - simulacro : Boolean
    - atributos : Map<String, Object>
    + {static} de(evento : Evento) : AuditContext
    + con(clave : String, valor : Object) : AuditContext
    + tipoEvento() : String
}

enum AuditAction {
    REGISTRO_CHECKIN
    CAMBIO_ESTADO_CHECKIN
    SOLICITUD_ASISTENCIA
    CAMBIO_ESTADO_EVENTO
}

enum AuditResult {
    EXITO
    FALLO
}

Evento "1" -- "0..*" Checkin : recibe (eventoId) >
Evento "1" -- "0..*" SolicitudAsistencia : agrupa (eventoId) >
Checkin "1" -- "0..*" SolicitudAsistencia : origina (checkinId) >
Evento "0..*" --> "1" EstadoEvento : estado
Checkin "0..*" --> "1" EstadoCheckin : estado
Checkin "0..*" --> "0..1" TipoUbicacion : ubicacionTipo
SolicitudAsistencia "0..*" --> "1" TipoUbicacion : ubicacionTipo
SolicitudAsistencia "0..*" --> "1" EstadoEnvio : estadoEnvio
RequesterIdentity "0..*" -- "0..*" Permiso : tiene (permisos) >
RequesterIdentity "1" -- "0..*" Checkin : reporta (usuarioId) >
AuditEvent "1" *-- "1" AuditContext : contexto
AuditContext "0..*" -- "0..1" Evento : describe (eventoId) >
AuditEvent "0..*" --> "1" AuditAction : accion
AuditEvent "0..*" --> "1" AuditResult : resultado

note right of Checkin
  Solo se agregan (trigger en la BD): el estado
  vigente de una persona es su check-in más
  reciente (vista v_checkins_vigentes).
end note
note bottom of SolicitudAsistencia
  Se crea con el check-in NEEDS_ASSISTANCE y se
  envía a MS05 después del commit; si MS05 falla
  queda PENDIENTE_ENVIO y la reenvía la tarea
  periódica con la identidad guardada.
end note
note top of RequesterIdentity
  Identidad del solicitante, construida con
  X-User-Id, X-User-Role y X-User-Permission
  que inyecta el API Gateway (MS04 no ve el JWT).
end note
@enduml
